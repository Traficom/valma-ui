{
  "name": "valma-ui",
  "productName": "VALMA",
  "version": "1.2.6",
  "private": true,
  "description": "VALMA Model System UI",
  "main": "src/main/index.cjs",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "electron-forge start",
    "start": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "build:renderer": "vite build",
    "make": "npm run build:renderer && electron-forge make",
    "publish": "npm run build:renderer && electron-forge publish",
    "package": "npm run build:renderer && electron-forge package"
  },
  "keywords": [],
  "author": "Traficom",
  "license": "EUPL-1.2",
  "config": {
    "forge": "./forge-config.cjs"
  },
  "type": "commonjs",
  "dependencies": {
    "chart.js": "^4.5.1",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.20",
    "del": "^8.0.0",
    "electron-dl": "^5.0.0",
    "electron-squirrel-startup": "^1.0.0",
    "electron-store": "^12.0.0",
    "lodash": "^4.18.1",
    "python-shell": "^3.0.1",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4",
    "react-tooltip": "^5.30.0",
    "unzipper": "^0.12.5",
    "uuid": "^13.0.0",
    "vex-js": "^4.1.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
