    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.6",
    "electron": "45.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
