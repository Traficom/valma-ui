{
  "compilerOptions": {
    "resolveJsonModule": true,
    "esModuleInterop": true,

    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "CommonJS",
    "jsx": "react-jsx",
    "types": ["node", "react", "react-dom"],

    "strict": false,
    "noImplicitAny": false,

    "allowJs": true,
    "checkJs": false,

    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "./dist"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "out"]
}